# Template only. This file contains no password, tokens or cookies.
# scripts/install.ps1 creates a private .env beside the application.
MODE=demo
ITMO_AUTH_METHOD=browser
BROWSER_CHANNEL=msedge
BROWSER_TIMEOUT_SECONDS=35
BROWSER_RANGE_DAYS=35
# Optional official OAuth mode, only with an authorized registered client:
ITMO_CLIENT_ID=
ITMO_SCOPES=openid
ITMO_REDIRECT_URI=http://127.0.0.1:8765/callback
ICLOUD_APPLE_ID=
# Create an EMPTY, dedicated calendar at icloud.com with this exact display name.
ICLOUD_CALENDAR_NAME=ITMO
SOURCE_TIMEZONE=Europe/Moscow
PAST_DAYS=14
FUTURE_DAYS=90
CHUNK_DAYS=7
SYNC_SECONDS=10800
MISSING_CONFIRMATIONS=2
MISSING_MIN_SECONDS=1800
MAX_DROP_FRACTION=0.5
MIN_MASS_DROP=3
TRUST_COMPLETE_RANGE=false
ALLOW_EMPTY_INITIAL=false
ALARM_MINUTES=0
